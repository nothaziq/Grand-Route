# Copy relevant lines into Vercel's Environment Variables (or a local
# .env for dev). Nothing here is required — the site works with none
# of these set.

# Points API-aware pages (currently: quote form, projects) at the real
# FastAPI backend instead of local mock data.
VITE_API_BASE_URL=https://grand-route.onrender.com

# Google Analytics 4 measurement ID (starts with "G-"). Create a free
# GA4 property at analytics.google.com, then paste the measurement ID
# here. Leave unset to run with zero analytics/tracking.
VITE_GA_MEASUREMENT_ID=
