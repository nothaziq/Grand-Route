# Copy to .env for local dev, or set these as environment variables in
# your hosting provider (Render/Railway/Fly). Nothing here is required
# to boot the service — sensible defaults are used (SQLite file, no
# email sending) so it runs locally with zero config.

ENVIRONMENT=production

# --- Database ---
# Local default: sqlite:///./grandroute.db
# Production (Render/Railway managed Postgres, example):
# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://your-site.vercel.app,https://grandroute.ae

# --- Email notifications (Gmail example, use an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=simpletyping.ae@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
NOTIFY_EMAIL=simpletyping.ae@gmail.com
FROM_EMAIL=simpletyping.ae@gmail.com

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=5

# --- Admin ---
ADMIN_API_KEY=choose-a-long-random-string
