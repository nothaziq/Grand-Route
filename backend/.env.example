# Copy to .env for local dev, or set these as environment variables in
# your hosting provider (Render/Railway/Fly). Nothing here is required
# to boot the service — sensible defaults are used (SQLite file, no
# email sending) so it runs locally with zero config.

ENVIRONMENT=production

# --- Database ---
# Local default: sqlite:///./grandroute.db
# Production (Render/Railway managed Postgres, example):
DATABASE_URL=postgresql+psycopg://user:password@host:5432/grandroute

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://your-site.vercel.app,https://grandroute.ae

# --- Email notifications ---
# PREFERRED: Resend (HTTPS API — works on Render's free tier, unlike
# raw SMTP, which Render blocks at the network level). Sign up free
# at resend.com, create an API key, paste it below. NOTIFY_EMAIL is
# where quote alerts land — any address you can check, doesn't need
# to match FROM_EMAIL or the Resend account's own email.
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=you@example.com
FROM_EMAIL=Grand Route <onboarding@resend.dev>

# FALLBACK: plain SMTP, only used if RESEND_API_KEY is unset. Works
# for local dev; will NOT work on Render's free tier.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=5

# --- Admin ---
ADMIN_API_KEY=choose-a-long-random-string
